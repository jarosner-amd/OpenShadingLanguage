// The texture seen directly, with s and t running from about -0.5 to 1.5
// over the quad in wrap.xml (its u and v run from 0.25 to 0.75 in the view):
// what is outside the image shows the wrap mode, black by default.
shader wrapuv(string filename = "")
{
    color c = texture(filename, 4 * u - 1.5, 4 * v - 1.5);
    Ci = c * emission();
}
