// A shader that calls shadeops on values that are only known at run time.
// sin and pow come from llvm_ops.cpp, whose device version is linked into
// the artifacts and inlined. noise comes from a source the device shadeops
// do not include yet, so it stays an external call.
shader
ops (output color Cout = 0)
{
    float n = noise(P * 4);
    float s = sin(u * 6.28) + pow(v, 2.2);
    Cout = color(n, s, u);
}
