// strlen() of a string that is not known when the shader is compiled. It
// needs the characters, which a GPU device does not have, so the group must
// not compile for AMDGPU, with an error that names the operation.
shader strlen (output color Cout = 0)
{
    string s = u > 0.5 ? "spam" : "eggs!";
    Cout = color(strlen(s));
}
