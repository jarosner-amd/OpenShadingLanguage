// Generated by CMake from amdgpu_rend_lib.cpp.in: one embedded bitcode
// block per architecture in OSL_HIP_TARGET_ARCHS.

#include "amdgpu_rend_lib.h"

@amdgpu_rend_lib_decls@

OSL_NAMESPACE_BEGIN

string_view
amdgpu_rend_lib(string_view arch)
{
    struct Entry {
        const char* arch;
        const unsigned char* data;
        const int* size;
    };
    static const Entry entries[] = {
@amdgpu_rend_lib_entries@
    };
    for (const Entry& e : entries)
        if (arch == e.arch)
            return string_view(reinterpret_cast<const char*>(e.data),
                               size_t(*e.size));
    return {};
}

OSL_NAMESPACE_END
